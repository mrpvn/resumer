// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId    String  @id
  email     String  @unique
  firstName String?
  lastName  String?
  imageUrl  String?

  templates String[]
  resumes      Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Resume {
  id              String           @id @default(cuid())
  user            User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  template        String?          @default("standard")
  userId          String
  title           String?
  personalInfo    PersonalInfo?
  workExperiences WorkExperience[]
  educations      Education[]
  skills          Skills?
  projects        Project[]
  achievements    Achievement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model PersonalInfo {
  id        String  @id @default(cuid())
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  linkedin  String?
  github    String?
  website   String?
  address   String?
  summary   String?

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("personal_info")
}

model WorkExperience {
  id String @id @default(cuid())

  companyName String?
  position    String?
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  workSummary String?

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Education {
  id              String    @id @default(cuid())
  institutionName String?
  location        String?
  degree          String?
  startDate       DateTime?
  endDate         DateTime?
  cgpa            String?
  subjects        String?

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Skills {
  id               String   @id @default(cuid())
  technicalSkills  String[]
  functionalSkills String[]

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Project {
  id             String    @id @default(cuid())
  projectTitle   String?
  startDate      DateTime?
  endDate        DateTime?
  link           String?
  projectSummary String?

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Achievement {
  id String @id @default(cuid())

  achievements String?

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

